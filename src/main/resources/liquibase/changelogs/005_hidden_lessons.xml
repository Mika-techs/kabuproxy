<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">

    <changeSet id="005-user-lesson-hidden" author="mik">
        <createTable tableName="user_lesson_hidden">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_user_lesson_hidden" foreignKeyName="fk_user_lesson_hidden_settings" references="user_settings(user_id)" deleteCascade="true"/>
            </column>
            <!-- lesson.subject as crawled -->
            <column name="subject" type="VARCHAR(100)">
                <constraints primaryKey="true" primaryKeyName="pk_user_lesson_hidden"/>
            </column>
            <!-- lesson.teacher, empty = the whole subject; a lesson is hidden if its subject or subject + teacher is listed -->
            <column name="teacher" type="VARCHAR(100)" defaultValue="">
                <constraints primaryKey="true" primaryKeyName="pk_user_lesson_hidden"/>
            </column>
        </createTable>
        <!-- same as user_lesson_color: subject/teacher are keys and must not collide case-insensitively -->
        <modifySql dbms="mysql">
            <append value=" CHARACTER SET utf8mb4 COLLATE utf8mb4_bin"/>
        </modifySql>
    </changeSet>
</databaseChangeLog>
