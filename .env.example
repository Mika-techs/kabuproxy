# Copy to .env and fill in. Never commit .env.

# --- database -------------------------------------------------------------
KABU_DB_HOST=mysql
KABU_DB_PORT=3306
KABU_DB_DATABASE=kabuproxy
KABU_DB_USERNAME=kabuproxy
KABU_DB_PASSWORD=change-me
# optional, without leading "?", e.g. useSSL=true&requireSSL=true
KABU_DB_JDBC_PARAMS=
# only used by the bundled mysql service (profile "localdb")
MYSQL_ROOT_PASSWORD=change-me-root

# --- credentials encryption (AES-256-GCM) ------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes all stored digikabu passwords unreadable.
KABU_CRED_KEY=

# --- OIDC / Authentik -----------------------------------------------------
# issuer URL of the Authentik application, e.g. https://auth.example.com/application/o/kabuproxy/
KABU_OIDC_PROVIDER_URI=
KABU_OIDC_CLIENT_ID=
KABU_OIDC_CLIENT_SECRET=
# public base URL of kabuProxy as seen by the browser (no trailing slash), e.g. https://kabu.example.com
KABU_PUBLIC_URL=http://localhost:8080
# Authentik group whose members get the admin role
KABU_OIDC_ADMIN_GROUP=kabuproxy-admin

# --- dev only ---------------------------------------------------------------
# true = skip Authentik, everyone is logged in as an admin. NEVER enable in production.
KABU_DEV_AUTH=false

# --- crawler --------------------------------------------------------------
KABU_CRAWL_ENABLED=true
KABU_CRAWL_INTERVAL_MINUTES=30
KABU_CRAWL_ACTIVE_FROM=06:00
KABU_CRAWL_ACTIVE_TO=22:00
KABU_REFRESH_COOLDOWN_MINUTES=5
KABU_DIGIKABU_BASE_URL=https://digikabu.de

# host port for the app
KABU_HTTP_PORT=8080
